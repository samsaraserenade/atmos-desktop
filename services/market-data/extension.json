{
  "apiVersion": 2,
  "tier": "first-party",
  "version": "0.4.0",
  "publisher": "atmos",
  "displayName": "Market Data",
  "description": "Exchange-independent live trades and candles for Atmos services and plugins.",
  "contract": {
    "rendererApi": "api.js",
    "capability": "market-data",
    "apiVersion": 2,
    "events": [
      "market-data:trade",
      "market-data:candle",
      "market-data:candle-history",
      "market-data:connection-status"
    ],
    "providers": [
      "binance",
      "bybit",
      "kraken",
      "coinbase"
    ]
  },
  "requires": {
    "extensions.manifest": 1
  },
  "permissions": {
    "network": [
      "api.bybit.com",
      "api.exchange.coinbase.com",
      "api.kraken.com",
      "fapi.binance.com",
      "fstream.binance.com",
      "stream.bybit.com",
      "ws-feed.exchange.coinbase.com",
      "ws.kraken.com"
    ],
    "node": [
      "crypto",
      "events"
    ],
    "electron": [
      "app"
    ],
    "ipc": true,
    "provides": [
      "market-data"
    ]
  },
  "library": true
}
