{
  "displayName": "Media Metadata",
  "description": "Reads tags and cover art from audio files for other extensions.",
  "apiVersion": 2,
  "tier": "first-party",
  "version": "1.0.1",
  "publisher": "atmos",
  "requires": {
    "extensions.manifest": 1
  },
  "permissions": {
    "node": [
      "fs",
      "path"
    ],
    "ipc": true,
    "provides": [
      "media-metadata"
    ]
  },
  "exports": {
    "ipc": {
      "read-file-bytes": "official",
      "write-cover-art": "official"
    }
  },
  "library": true
}
