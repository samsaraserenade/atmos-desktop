{
  "apiVersion": 3,
  "tier": "first-party",
  "version": "1.0.2",
  "publisher": "atmos",
  "runtime": "frame",
  "isolation": "origin",
  "exports": {},
  "displayName": "Matrix Chat",
  "description": "Chat on Matrix, with encryption, rooms in the sidebar and notifications.",
  "requires": {
    "extensions.manifest": 1,
    "extensions.frames": 3
  },
  "contributes": {
    "panel": {
      "label": "Chat",
      "icon": "icon.svg",
      "glass": true
    },
    "sidebar": [
      {
        "legacyId": "matrix-chat-rooms",
        "label": "Matrix Chat",
        "icon": "icon.svg",
        "order": 41,
        "defaultHeight": 300,
        "showIn": [
          "matrix-chat"
        ]
      },
      {
        "id": "account",
        "entry": "sidebar-account.js",
        "label": "Matrix Account",
        "icon": "icon-account.svg",
        "order": 42,
        "resizable": false,
        "showIn": [
          "matrix-chat"
        ]
      }
    ],
    "boot": {
      "entry": "boot.js"
    }
  },
  "legacyStorage": {
    "deleteIndexedDB": [
      "matrix-js-sdk*"
    ],
    "sharedOriginIndexedDB": [
      "matrix-js-sdk*"
    ]
  },
  "dependencies": {
    "audio": "^1.0.0",
    "fullscreen-viewer": "^1.0.0",
    "wallpaper": "^1.0.0"
  },
  "permissions": {
    "network": [
      "github.com",
      "matrix.org",
      "matrix.to"
    ],
    "browser": [
      "wasm"
    ],
    "node": [
      "crypto",
      "electron",
      "fs",
      "http",
      "path"
    ],
    "electron": [
      "net",
      "dialog",
      "app",
      "BrowserWindow",
      "shell",
      "safeStorage"
    ],
    "ipc": true,
    "invokes": [
      "service:audio",
      "service:wallpaper",
      "service:fullscreen-viewer"
    ]
  }
}
