{
  "apiVersion": 4,
  "engines": {
    "atmos": ">=0.20.0"
  },
  "tier": "first-party",
  "version": "1.1.2",
  "publisher": "atmos",
  "runtime": "frame",
  "isolation": "origin",
  "exports": {},
  "displayName": "Matrix Chat",
  "description": "Chat on Matrix, with encryption, rooms in the sidebar and notifications.",
  "requires": {
    "extensions.manifest": 1,
    "extensions.frames": 3
  },
  "contributes": {
    "panel": {
      "label": "Chat",
      "icon": "icon.svg",
      "glass": true
    },
    "sidebar": [
      {
        "legacyId": "matrix-chat-rooms",
        "label": "Matrix Chat",
        "icon": "icon.svg",
        "order": 41,
        "defaultHeight": 300,
        "showIn": [
          "matrix-chat"
        ]
      },
      {
        "id": "account",
        "entry": "sidebar-account.js",
        "label": "Matrix Account",
        "icon": "icon-account.svg",
        "order": 42,
        "resizable": false,
        "showIn": [
          "matrix-chat"
        ]
      }
    ],
    "boot": {
      "entry": "boot.js"
    },
    "commands": [
      {
        "name": "go",
        "args": "room or person",
        "about": "Open one of your rooms or chats",
        "takesArgs": true,
        "suggests": true
      },
      {
        "name": "join",
        "args": "#room:server, a link, or search",
        "about": "Join a room or space",
        "takesArgs": true,
        "suggests": true
      },
      {
        "name": "dm",
        "args": "@name:server",
        "about": "Message someone",
        "takesArgs": true,
        "suggests": true
      },
      {
        "name": "create-room",
        "args": "name",
        "about": "Create a room",
        "takesArgs": true,
        "suggests": true
      },
      {
        "name": "create-space",
        "args": "name",
        "about": "Create a space",
        "takesArgs": true,
        "suggests": true
      },
      {
        "name": "notifications",
        "args": "on or off",
        "about": "Turn the ping for new messages on or off",
        "takesArgs": true,
        "suggests": true
      },
      {
        "name": "invite",
        "args": "@name:server",
        "about": "Invite someone to the open room",
        "takesArgs": true,
        "suggests": true
      },
      {
        "name": "leave",
        "about": "Leave the open room",
        "suggests": true
      }
    ]
  },
  "legacyStorage": {
    "deleteIndexedDB": [
      "matrix-js-sdk*"
    ],
    "sharedOriginIndexedDB": [
      "matrix-js-sdk*"
    ]
  },
  "dependencies": {
    "audio": "^1.0.0",
    "fullscreen-viewer": "^1.0.0",
    "wallpaper": "^1.0.0"
  },
  "permissions": {
    "network": [
      "github.com",
      "matrix.org",
      "matrix.to"
    ],
    "browser": [
      "wasm"
    ],
    "node": [
      "crypto",
      "electron",
      "fs",
      "http",
      "path"
    ],
    "electron": [
      "net",
      "dialog",
      "app",
      "BrowserWindow",
      "shell",
      "safeStorage"
    ],
    "ipc": true,
    "invokes": [
      "service:audio",
      "service:wallpaper",
      "service:fullscreen-viewer"
    ]
  }
}
