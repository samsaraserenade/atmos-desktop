{
  "apiVersion": 4,
  "engines": {
    "atmos": ">=0.21.0"
  },
  "tier": "first-party",
  "version": "1.2.3",
  "publisher": "atmos",
  "runtime": "frame",
  "isolation": "origin",
  "exports": {},
  "displayName": "Audio Player",
  "description": "A music player for your own library, in a drawer at the bottom of the screen.",
  "requires": {
    "extensions.manifest": 1,
    "extensions.frames": 3
  },
  "contributes": {
    "panel": {
      "label": "Music",
      "icon": "icon.svg",
      "drawer": {
        "bar": 54,
        "keys": true
      }
    },
    "sidebar": [
      {
        "id": "queue",
        "legacyId": "audio-player-queue",
        "entry": "sidebar-queue.js",
        "label": "Queue",
        "icon": "icon-queue.svg",
        "order": 21
      },
      {
        "id": "library",
        "entry": "sidebar-library.js",
        "label": "Library",
        "icon": "icon-library.svg",
        "order": 22
      }
    ],
    "boot": {
      "entry": "boot.js"
    },
    "commands": [
      {
        "name": "song",
        "args": "title, artist or album",
        "about": "Play a song from your library",
        "takesArgs": true,
        "suggests": true
      },
      {
        "name": "album",
        "args": "name or artist",
        "about": "Play an album from your library",
        "takesArgs": true,
        "suggests": true
      }
    ]
  },
  "legacyStorage": {
    "indexedDB": [
      {
        "name": "samsara_db",
        "keys": [
          "audio-player:*",
          "library-meta",
          "waveform-cache",
          "playlist"
        ]
      }
    ],
    "sharedOrigin": {
      "indexedDB": [
        "audio-player"
      ]
    }
  },
  "dependencies": {
    "audio": "^1.0.0",
    "media-metadata": "^1.0.0",
    "wallpaper": "^1.0.0",
    "now-playing": {
      "version": "^1.1.0",
      "optional": true,
      "recommended": true
    }
  },
  "permissions": {
    "node": [
      "fs",
      "path",
      "stream"
    ],
    "electron": [
      "app",
      "BrowserWindow",
      "dialog",
      "shell"
    ],
    "ipc": true,
    "resources": [
      "audio-player-media"
    ],
    "invokes": [
      "service:audio",
      "service:media-metadata",
      "service:wallpaper",
      "service:now-playing"
    ]
  }
}
