{
  "apiVersion": 3,
  "tier": "first-party",
  "version": "1.0.4",
  "publisher": "atmos",
  "runtime": "frame",
  "isolation": "origin",
  "exports": {},
  "displayName": "Audio Player",
  "description": "A music player for your own library, in a drawer at the bottom of the screen.",
  "requires": {
    "extensions.manifest": 1,
    "extensions.frames": 3
  },
  "contributes": {
    "panel": {
      "label": "Music",
      "icon": "icon.svg",
      "drawer": {
        "bar": 54,
        "keys": true
      }
    },
    "sidebar": [
      {
        "label": "Now Playing",
        "icon": "icon.svg",
        "order": 20,
        "resizable": false
      },
      {
        "id": "queue",
        "entry": "sidebar-queue.js",
        "label": "Queue",
        "icon": "icon-queue.svg",
        "order": 21
      },
      {
        "id": "library",
        "entry": "sidebar-library.js",
        "label": "Library",
        "icon": "icon-library.svg",
        "order": 22
      }
    ],
    "boot": {
      "entry": "boot.js",
      "keys": [
        "Space"
      ]
    }
  },
  "legacyStorage": {
    "indexedDB": [
      {
        "name": "samsara_db",
        "keys": [
          "audio-player:*",
          "library-meta",
          "waveform-cache",
          "playlist"
        ]
      }
    ],
    "sharedOrigin": {
      "indexedDB": [
        "audio-player"
      ]
    }
  },
  "dependencies": {
    "audio": "^1.0.0",
    "media-metadata": "^1.0.0",
    "wallpaper": "^1.0.0"
  },
  "permissions": {
    "node": [
      "fs",
      "path",
      "stream"
    ],
    "electron": [
      "app",
      "BrowserWindow",
      "dialog",
      "shell"
    ],
    "ipc": true,
    "resources": [
      "audio-player-media"
    ],
    "invokes": [
      "service:audio",
      "service:media-metadata",
      "service:wallpaper"
    ]
  }
}
