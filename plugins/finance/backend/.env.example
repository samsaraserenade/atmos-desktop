# Copy to .env beside compose.yaml. Keep it private.

# Devices pair with tokens of their own:
#   docker compose exec api python /app/server.py device add laptop
# A shared token for every device (before 0.9) still works if set here, at
# least 32 characters; leave it unset for new installs.
#ATMOS_PORTFOLIO_TOKEN=

# The address Finance uses, for the pairing code. Required with Docker (the
# container listens on every interface, so it can't guess). Examples:
#   http://100.x.y.z:8787            (Tailscale; also set ATMOS_PORTFOLIO_BIND)
#   https://portfolio.example.com    (behind a TLS reverse proxy)
ATMOS_PORTFOLIO_PUBLIC_URL=

# Which host address the API is published on (default: only this computer).
#ATMOS_PORTFOLIO_BIND=127.0.0.1
#ATMOS_PORTFOLIO_HOST_PORT=8787

# holdings_history retention (see README.md, Retention).
#ATMOS_PORTFOLIO_RAW_DAYS=30
#ATMOS_PORTFOLIO_HOURLY_DAYS=365
#ATMOS_PORTFOLIO_RETENTION=off
