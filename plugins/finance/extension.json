{
  "apiVersion": 3,
  "tier": "first-party",
  "version": "1.0.12",
  "publisher": "atmos",
  "runtime": "frame",
  "isolation": "origin",
  "exports": {},
  "displayName": "Finance",
  "description": "Your portfolio from your own portfolio server, with a watchlist and market charts.",
  "requires": {
    "extensions.frames": 3
  },
  "contributes": {
    "panel": {
      "entry": "frame-panel.js",
      "legacyId": "portfolio-tracker",
      "label": "Finance",
      "icon": "icons/portfolio-tracker.svg"
    },
    "sidebar": [
      {
        "entry": "frame-widget-balance.js",
        "legacyId": "portfolio-balance-ticker",
        "label": "Balance",
        "icon": "icons/portfolio-balance-ticker.svg",
        "order": -110
      },
      {
        "id": "performance",
        "entry": "frame-widget-performance.js",
        "legacyId": "portfolio-balance",
        "label": "Performance",
        "icon": "icons/portfolio-balance.svg",
        "order": -100
      },
      {
        "id": "connections",
        "entry": "frame-widget-connections.js",
        "legacyId": "portfolio-connections",
        "label": "Portfolio Connections",
        "icon": "icons/portfolio-connections.svg",
        "order": -80
      },
      {
        "id": "spot",
        "entry": "frame-widget-spot.js",
        "legacyId": "portfolio-positions",
        "label": "Spot",
        "icon": "icons/portfolio-positions.svg",
        "order": 0
      },
      {
        "id": "allocation",
        "entry": "frame-widget-allocation.js",
        "legacyId": "portfolio-allocation",
        "label": "Allocation",
        "icon": "icons/portfolio-balance.svg",
        "order": -70
      },
      {
        "id": "futures",
        "entry": "frame-widget-futures.js",
        "legacyId": "portfolio-futures",
        "label": "Futures",
        "icon": "icons/portfolio-futures.svg",
        "order": 1
      }
    ],
    "boot": {
      "entry": "frame-engine.js"
    }
  },
  "legacyStorage": {
    "state": [
      "portfolio-tracker",
      "markets",
      "watchlist",
      "currency"
    ],
    "indexedDB": [
      {
        "name": "samsara_db",
        "keys": [
          "portfolio-tracker:*",
          "chart-history",
          "chart-hidden"
        ]
      }
    ],
    "localStorage": [
      "atmos:charting-*"
    ],
    "sharedOrigin": {
      "indexedDB": [
        "finance-assets"
      ],
      "localStorage": [
        "finance:state:*",
        "atmos:charting-*"
      ]
    }
  },
  "dependencies": {
    "charting": "^1.2.0",
    "currency": "^1.0.0",
    "market-data": {
      "version": "^0.4.0",
      "optional": true,
      "recommended": true
    }
  },
  "permissions": {
    "network": [
      "api.binance.com",
      "api.coingecko.com",
      "api.dexscreener.com",
      "cdn.moneyconvert.net"
    ],
    "node": [
      "electron",
      "fs",
      "path"
    ],
    "electron": [
      "app",
      "safeStorage"
    ],
    "ipc": true,
    "invokes": [
      "service:charting",
      "service:currency",
      "service:market-data"
    ]
  }
}
