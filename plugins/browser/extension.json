{
  "apiVersion": 4,
  "engines": {
    "atmos": ">=0.21.0"
  },
  "tier": "first-party",
  "version": "1.2.1",
  "publisher": "atmos",
  "runtime": "frame",
  "isolation": "origin",
  "exports": {},
  "displayName": "Atmos Browser",
  "description": "A web browser in an Atmos panel: tabs, bookmarks, history, private tabs and downloads, in a browsing session of its own.",
  "contributes": {
    "panel": {
      "label": "Browser",
      "icon": "icon.svg",
      "glass": true
    },
    "sidebar": [
      {
        "label": "Tabs",
        "icon": "icon-tabs.svg",
        "order": 50
      },
      {
        "id": "bookmarks",
        "entry": "sidebar-bookmarks.js",
        "label": "Bookmarks",
        "icon": "icon-bookmarks.svg",
        "order": 51
      }
    ],
    "settings": {
      "label": "Atmos Browser",
      "icon": "icon.svg"
    },
    "boot": {
      "entry": "boot.js"
    },
    "commands": [
      {
        "name": "new-tab",
        "args": "address or search",
        "about": "Open a new tab, there",
        "takesArgs": true,
        "suggests": true
      },
      {
        "name": "tab",
        "args": "tab",
        "about": "Go to one of your tabs",
        "takesArgs": true,
        "suggests": true
      },
      {
        "name": "close-tab",
        "args": "tab",
        "about": "Close the current tab, or one by name",
        "takesArgs": true,
        "suggests": true
      }
    ]
  },
  "permissions": {
    "web": true,
    "invokes": [
      "service:now-playing"
    ]
  },
  "dependencies": {
    "now-playing": {
      "version": "^1.0.0",
      "optional": true,
      "recommended": true
    }
  }
}
