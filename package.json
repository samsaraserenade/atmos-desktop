{
  "name": "atmos",
  "version": "0.17.0",
  "description": "A modular personal desktop environment.",
  "license": "GPL-3.0-only",
  "author": "hashy",
  "main": "core/main.js",
  "scripts": {
    "start": "electron .",
    "test:core": "node --test core/js/core/*.test.cjs",
    "test:services": "node --experimental-vm-modules --test scripts/service-core-v2-contract.test.cjs",
    "test:permissions": "node --test scripts/extension-permissions.test.cjs",
    "test:build": "node --test scripts/after-pack.test.cjs",
    "test:finance": "node --experimental-vm-modules --test plugins/finance/tests/*.test.cjs plugins/finance/markets/tests/*.test.cjs",
    "test:sdk": "node --test scripts/new-extension.test.cjs scripts/sdk-contract.test.mjs",
    "test:all": "node scripts/test-all.cjs",
    "new:extension": "node scripts/new-extension.cjs",
    "build": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable",
    "build:personal": "node scripts/build-personal.cjs",
    "publish:prepare": "node scripts/publish-release.cjs",
    "keys:create": "node scripts/extension-keys.cjs create",
    "keys:show": "node scripts/extension-keys.cjs show",
    "pack:extensions": "node scripts/pack-extensions.cjs"
  },
  "build": {
    "appId": "com.hashy.atmosphere",
    "productName": "Atmos",
    "asar": false,
    "afterPack": "scripts/after-pack.cjs",
    "win": {
      "target": "nsis",
      "icon": "core/assets/icon.ico"
    },
    "nsis": {
      "artifactName": "Atmos Setup ${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Atmos",
      "uninstallDisplayName": "Atmos",
      "deleteAppDataOnUninstall": false
    },
    "files": [
      "core/**/*",
      "!core/**/*.test.cjs"
    ],
    "extraResources": [
      {
        "from": "plugins",
        "to": "extensions/plugins",
        "filter": [
          "**/*",
          "!**/tests/**",
          "!**/data/**",
          "!**/node_modules/**",
          "!*/mobile-android/**",
          "!*/android-client/**",
          "!*/backend/**",
          "!*/tools/**",
          "!**/*.log"
        ]
      },
      {
        "from": "services",
        "to": "extensions/services",
        "filter": [
          "**/*",
          "!**/tests/**",
          "!**/benchmarks/**",
          "!**/*.log"
        ]
      }
    ]
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@ghostery/adblocker": "2.18.2"
  }
}
